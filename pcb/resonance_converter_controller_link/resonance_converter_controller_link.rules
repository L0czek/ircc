
(rules PCB resonance_converter_controller_link
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 50)
    (plane_via_costs 5)
    (start_ripup_costs 100)
    (start_pass_no 892)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.6)
      (against_preferred_direction_trace_costs 3.0)
    )
    (layer_rule VCC
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.4)
    )
    (layer_rule GND
      (active off)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 2.4)
    )
    (layer_rule SIG
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
    (layer_rule GND2
      (active off)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.7)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.6)
      (against_preferred_direction_trace_costs 3.0)
    )
  )
  (rule
    (width 200.0)
    (clear 200.0)
    (clear 100.0 (type smd_to_turn_gap))
    (clear 50.0 (type smd_smd))
  )
  (padstack "Via[0-5]_450:200_um"
    (shape
      (circle F.Cu 450.0 0.0 0.0)
    )
    (shape
      (circle VCC 450.0 0.0 0.0)
    )
    (shape
      (circle GND 450.0 0.0 0.0)
    )
    (shape
      (circle SIG 450.0 0.0 0.0)
    )
    (shape
      (circle GND2 450.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 450.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-5]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle VCC 800.0 0.0 0.0)
    )
    (shape
      (circle GND 800.0 0.0 0.0)
    )
    (shape
      (circle SIG 800.0 0.0 0.0)
    )
    (shape
      (circle GND2 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (padstack "Via[0-5]_2000:1000_um"
    (shape
      (circle F.Cu 2000.0 0.0 0.0)
    )
    (shape
      (circle VCC 2000.0 0.0 0.0)
    )
    (shape
      (circle GND 2000.0 0.0 0.0)
    )
    (shape
      (circle SIG 2000.0 0.0 0.0)
    )
    (shape
      (circle GND2 2000.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 2000.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-5]_450:200_um" "Via[0-5]_450:200_um" default
  )
  (via 
    "Via[0-5]_800:400_um" "Via[0-5]_800:400_um" default
  )
  (via 
    "Via[0-5]_2000:1000_um" "Via[0-5]_2000:1000_um" default
  )
  (via 
    "Via[0-5]_450:200_um-kicad_default" "Via[0-5]_450:200_um" "kicad_default"
  )
  (via 
    "Via[0-5]_800:400_um-kicad_default" "Via[0-5]_800:400_um" "kicad_default"
  )
  (via 
    "Via[0-5]_2000:1000_um-kicad_default" "Via[0-5]_2000:1000_um" "kicad_default"
  )
  (via_rule
    default "Via[0-5]_450:200_um"
  )
  (via_rule
    "kicad_default" "Via[0-5]_450:200_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu SIG B.Cu)
    )
  )
  (class "kicad_default"
    VAA "VBUS_DOCK" VOUT VCC VSYS GND "Net-(JP1-C)" "unconnected-(M1-Tacho-Pad3)"
    "FAN_PWM" +5V "WS2812B_OUT" +12V OUT1 OUT2 OUT3 OUT4
    "OUT_SYNC_1+" "AUX_PWM_CH2" GPIO7 GPIO6 GPIO5 GPIO4 "AUX_TX" "AUX_RX"
    "I2C_EXT_SDA" MCO "HRTIM_FLT3" "ISENSE_4" "ISENSE_2" "OCD2_IN" "OCD_IN" "AUX_ADC"
    "OUT_SYNC_3-" "OUT_SYNC_3+" "OUT_SYNC_2-" "OUT_SYNC_2+" "OUT_SYNC_1-" "AUX_PWM_CH1" GPIO0 GPIO1
    GPIO2 GPIO3 "CTRL_TX" "CTRL_RX" "I2C_EXT_SCL" "DAC_OUT" "HRTIM_EEV9" "ISENSE_3"
    "ISENSE_1" "VSENSE_IN" "FB_IN"
    (clearance_class "kicad_default")
    (via_rule kicad_default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu SIG B.Cu)
    )
  )
)